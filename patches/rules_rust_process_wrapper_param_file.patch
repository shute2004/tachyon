+mod param_file_test {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    static NEXT_PARAM_FILE: AtomicUsize = AtomicUsize::new(0);
+
+    fn param_file_path() -> std::path::PathBuf {
+        let timestamp = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let sequence = NEXT_PARAM_FILE.fetch_add(1, Ordering::Relaxed);
+        std::env::temp_dir().join(format!(
+            "rules rust process wrapper params {} {timestamp} {sequence}.txt",
+            std::process::id(),
+        ))
+    }
+
+    fn write_param_file(args: &[&str]) -> std::path::PathBuf {
+        let path = param_file_path();
+        let contents = args
+            .iter()
+            .map(|arg| format!("{arg}\n"))
+            .collect::<String>();
+        std::fs::write(&path, contents).unwrap();
+        path
+    }
+
+    #[test]
+    fn expands_one_param_file_in_order_and_preserves_spaces() {
+        let path = write_param_file(&[
+            "--item",
+            "first value with spaces",
+            "--item",
+            "second value with spaces",
+            "",
+        ]);
+        assert!(path.to_string_lossy().contains(' '));
+        let response_arg = format!("@{}", path.display());
+        let mut item = None;
+        let mut parser = Flags::new();
+        parser.define_repeated_flag("--item", "", &mut item);
+
+        let result = parser
+            .parse(vec!["process_wrapper".to_owned(), response_arg])
+            .unwrap();
+        assert!(matches!(result, ParseOutcome::Parsed(args) if args.is_empty()));
+        assert_eq!(
+            item,
+            Some(vec![
+                "first value with spaces".to_owned(),
+                "second value with spaces".to_owned(),
+                "".to_owned(),
+            ])
+        );
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn does_not_expand_substitution_values_or_child_param_files() {
+        let path = write_param_file(&["--subst", "@literal substitution"]);
+        let response_arg = format!("@{}", path.display());
+        let mut subst = None;
+        let mut parser = Flags::new();
+        parser.define_repeated_flag("--subst", "", &mut subst);
+
+        let result = parser
+            .parse(vec![
+                "process_wrapper".to_owned(),
+                response_arg,
+                "--".to_owned(),
+                "rustc".to_owned(),
+                "@rustc params.rsp".to_owned(),
+            ])
+            .unwrap();
+        assert!(matches!(
+            result,
+            ParseOutcome::Parsed(args)
+                if args == vec!["rustc".to_owned(), "@rustc params.rsp".to_owned()]
+        ));
+        assert_eq!(subst, Some(vec!["@literal substitution".to_owned()]));
+        std::fs::remove_file(path).unwrap();
+    }
+
