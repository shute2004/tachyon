+fn expand_param_file(argv: Vec<String>) -> Result<Vec<String>, FlagParseError> {
+    // process_wrapper_flags is the first Args object after argv[0], so Bazel
+    // replaces it with a single @file argument when use_param_file is enabled.
+    // Expand only that pointer; scanning its contents would reinterpret literal
+    // @values (for example a --subst value), and rustc's @files follow --.
+    let Some(param_file_arg) = argv.get(1) else {
+        return Ok(argv);
+    };
+    let Some(param_file_path) = param_file_arg.strip_prefix('@') else {
+        return Ok(argv);
+    };
+    if param_file_path.is_empty() {
+        return Ok(argv);
+    }
+
+    let contents = std::fs::read_to_string(param_file_path).map_err(|error| {
+        FlagParseError::ParamFileReadError {
+            path: param_file_path.to_owned(),
+            error: error.to_string(),
+        }
+    })?;
+    let param_file_args = contents.lines().map(str::to_owned).collect::<Vec<_>>();
+    let mut expanded = Vec::with_capacity(argv.len() - 1 + param_file_args.len());
+    expanded.push(argv[0].clone());
+    expanded.extend(param_file_args);
+    expanded.extend(argv.into_iter().skip(2));
+    Ok(expanded)
+}
